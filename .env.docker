APP_NAME=SMCH
APP_ENV=local
APP_KEY=base64:h/34E80TTeZEZV1es9gzJ+xTO6pkYqhzvqC5haYr+IY=
APP_DEBUG=true
APP_URL=https://contend-fender-evasion.ngrok-free.dev

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- DATABASE: MYSQL (DOCKER INTERNAL) ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=smch
DB_USERNAME=smch
DB_PASSWORD=secret

# --- SESSION & SECURITY (CRITICAL FOR CROSS-DOMAIN) ---
# Use 'cookie' driver to avoid file permission issues in Docker
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
# Allows the cookie to be shared between ngrok and vercel
SESSION_DOMAIN=.ngrok-free.dev
# Required because ngrok and vercel use HTTPS
SESSION_SECURE_COOKIE=true

# --- SANCTUM & CORS SETTINGS ---
# The domains allowed to hit your API
ALLOWED_ORIGINS=https://smch-web.vercel.app,http://localhost:5173

# The domains allowed to receive the Session/CSRF cookie
SANCTUM_STATEFUL_DOMAINS=smch-web.vercel.app,localhost:5173,contend-fender-evasion.ngrok-free.dev

# --- OTHER DRIVERS ---
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"